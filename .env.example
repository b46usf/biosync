# Optional. Defaults to the standard OpenStreetMap raster tile endpoint.
VITE_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Keep these values in Vercel Project Settings > Environment Variables.
# Never use a VITE_ prefix for OAuth secrets.
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_REDIRECT_URI=https://your-domain.example/api/google-health/callback
# Use at least 32 random characters; generate with: openssl rand -base64 48
GOOGLE_HEALTH_COOKIE_SECRET=
